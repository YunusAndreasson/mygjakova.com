{
  "name": "gjakova",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "An elegant cultural tourist guide to Gjakova, Kosovo.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/gen-icons.mjs && node scripts/gen-og.mjs && astro build",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build",
    "preview": "astro preview",
    "og": "node scripts/gen-og.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "map:style": "node scripts/gen-map-style.mjs",
    "map:locator": "node scripts/gen-locator.mjs",
    "deploy": "astro check && pnpm build && wrangler pages deploy --branch main",
    "cf:preview": "pnpm build && wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "7.3.3",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.5",
    "@protomaps/basemaps": "^5.7.2",
    "@tailwindcss/vite": "4.3.4",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "^6.0.3",
    "vitest": "5.1.0",
    "wrangler": "^4.158.0"
  }
}
