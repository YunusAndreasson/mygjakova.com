{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.astro",
      "!public/map",
      "!src/lib/kosovoLocator.ts",
      "!**/*.md",
      "!**/*.svg",
      "!**/*.yaml",
      "!**/*.yml"
    ]
  },
  "assist": { "enabled": false },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  }
}
