---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { useTranslations, localizedPath } from '~/i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout title={t('notFound.title')} noindex>
  <section class="wrap notfound">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1 class="notfound__title">{t('notFound.title')}</h1>
    <p class="notfound__lede">{t('notFound.lede')}</p>
    <a class="btn btn--primary" href={localizedPath(lang, '/')}>{t('notFound.cta')}</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(4rem, 2rem + 10vw, 9rem);
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .notfound__code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 14vw, 11rem);
    line-height: 0.9;
    color: var(--color-terracotta-500);
    margin: 0;
    font-style: italic;
  }
  .notfound__title {
    font-size: var(--text-display);
    margin: 0;
  }
  .notfound__lede {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--color-sand-700);
    max-inline-size: 40ch;
  }
  .notfound .btn {
    margin-block-start: 1rem;
  }
</style>
