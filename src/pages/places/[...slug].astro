---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PlaceGuide from '~/components/views/PlaceGuide.astro';
import { getPlaces, entrySlug } from '~/lib/collections';

export const getStaticPaths = (async () => {
  const places = await getPlaces('en');
  return places.map((place) => ({
    params: { slug: entrySlug(place.id) },
    props: { place },
  }));
}) satisfies GetStaticPaths;

const lang = 'en' as const;
const { place } = Astro.props;

const origin = Astro.site ?? new URL(Astro.url.origin);
const { title, summary, coordinates, address } = place.data;
const placeLd = {
  '@type': 'TouristAttraction',
  name: title,
  description: summary,
  url: new URL(Astro.url.pathname, origin).href,
  inLanguage: lang,
  isPartOf: { '@id': `${origin.href}#website` },
  ...(coordinates && {
    geo: { '@type': 'GeoCoordinates', latitude: coordinates.lat, longitude: coordinates.lng },
  }),
  ...(address && { address }),
};
---

<BaseLayout title={place.data.title} description={place.data.summary} jsonLd={placeLd}>
  <PlaceGuide place={place} lang={lang} />
</BaseLayout>
