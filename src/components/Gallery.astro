---
/**
 * Photo gallery for a place guide — renders the `gallery` content field.
 * Responsive grid of optimized thumbnails; each opens an accessible, native
 * <dialog> lightbox (keyboard + arrow navigation, Esc/backdrop close, focus is
 * trapped and restored by the platform). Progressive enhancement: with no JS
 * the thumbnail grid is still a perfectly good gallery.
 *
 * Sourced photographs carry attribution: each caption + credit shows in the
 * lightbox, and a full, linked credits list sits below the grid (visible even
 * without opening an image) to satisfy the image licences.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImageCredit, { type Credit } from '~/components/ImageCredit.astro';
import { useTranslations, type Locale } from '~/i18n/utils';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: Credit;
}
interface Props {
  images: GalleryImage[];
  lang: Locale;
}

const { images, lang } = Astro.props;
const t = useTranslations(lang);

// Build-time, same-origin large variants for the lightbox.
const fulls = await Promise.all(
  images.map((img) => getImage({ src: img.src, width: 1600, format: 'webp' })),
);

// Plain-text credit for the lightbox caption (the linked version lives in the
// credits list below). e.g. "Aljabakphoto · Wikimedia Commons · CC BY-SA 4.0".
const creditText = (c?: Credit) =>
  [c?.author, c?.source, c?.license].filter(Boolean).join(' · ');

// Any attribution to surface in the credits list at all?
const hasCredits = images.some((img) => img.caption || creditText(img.credit));
---

{
  images.length > 0 && (
    <section class="gallery" aria-label={t('gallery.title')}>
      <h2 class="gallery__title">{t('gallery.title')}</h2>
      <ul class="gallery__grid" role="list">
        {images.map((img, i) => (
          <li class="gallery__item">
            <button
              type="button"
              class="gallery__thumb"
              data-gallery-open
              data-full={fulls[i].src}
              data-alt={img.alt}
              data-caption={img.caption ?? ''}
              data-credit={creditText(img.credit)}
              aria-label={t('gallery.view')}
            >
              <Image
                src={img.src}
                alt={img.alt}
                width={640}
                densities={[1, 2]}
                loading="lazy"
                class="gallery__img"
              />
            </button>
          </li>
        ))}
      </ul>

      {hasCredits && (
        <details class="gallery__credits">
          <summary>{t('gallery.credits')}</summary>
          <ul class="gallery__credit-list" role="list">
            {images.map((img) => (
              <li class="gallery__credit-item">
                {img.caption && <span class="gallery__credit-cap">{img.caption}</span>}
                <ImageCredit credit={img.credit} />
              </li>
            ))}
          </ul>
        </details>
      )}

      <dialog class="lightbox" data-gallery-dialog aria-label={t('gallery.title')}>
        <figure class="lightbox__fig">
          <img class="lightbox__img" data-gallery-image alt="" />
          <figcaption class="lightbox__cap">
            <span class="lightbox__caption" data-gallery-caption />
            <span class="lightbox__credit" data-gallery-credit />
          </figcaption>
        </figure>
        <div class="lightbox__bar">
          <button
            type="button"
            class="lightbox__btn"
            data-gallery-prev
            aria-label={t('gallery.prev')}
          >
            <span aria-hidden="true">‹</span>
          </button>
          <span class="lightbox__count" data-gallery-count aria-live="polite" />
          <button
            type="button"
            class="lightbox__btn"
            data-gallery-next
            aria-label={t('gallery.next')}
          >
            <span aria-hidden="true">›</span>
          </button>
          <button
            type="button"
            class="lightbox__btn lightbox__close"
            data-gallery-close
            aria-label={t('gallery.close')}
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      </dialog>
    </section>
  )
}

<script>
  function initGallery(section: HTMLElement) {
    if (section.dataset.bound) return;
    const dialog = section.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
    const imgEl = section.querySelector<HTMLImageElement>('[data-gallery-image]');
    const countEl = section.querySelector<HTMLElement>('[data-gallery-count]');
    const capEl = section.querySelector<HTMLElement>('[data-gallery-caption]');
    const creditEl = section.querySelector<HTMLElement>('[data-gallery-credit]');
    const thumbs = Array.from(section.querySelectorAll<HTMLElement>('[data-gallery-open]'));
    if (!dialog || !imgEl || thumbs.length === 0) return;
    section.dataset.bound = '1';

    const total = thumbs.length;
    let index = 0;
    const show = (i: number) => {
      index = (i + total) % total;
      const thumb = thumbs[index];
      imgEl.src = thumb.dataset.full || '';
      imgEl.alt = thumb.dataset.alt || '';
      if (countEl) countEl.textContent = `${index + 1} / ${total}`;
      if (capEl) capEl.textContent = thumb.dataset.caption || '';
      if (creditEl) creditEl.textContent = thumb.dataset.credit || '';
    };

    thumbs.forEach((thumb, i) =>
      thumb.addEventListener('click', () => {
        show(i);
        if (!dialog.open) dialog.showModal();
      }),
    );
    section.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(index - 1));
    section.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(index + 1));
    section.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
    // Click on the backdrop (the dialog element itself) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'ArrowRight') show(index + 1);
    });
  }

  function setupGalleries() {
    document.querySelectorAll<HTMLElement>('.gallery').forEach(initGallery);
  }
  document.addEventListener('astro:page-load', setupGalleries);
</script>

<style>
  .gallery {
    margin-block-start: var(--space-section);
  }
  .gallery__title {
    font-size: 1.4rem;
    margin-block-end: var(--space-md);
  }
  .gallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
  }
  .gallery__item {
    margin: 0;
  }
  .gallery__thumb {
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    background: var(--color-sand-200);
    aspect-ratio: 4 / 3;
    transition: transform var(--dur) var(--ease);
  }
  .gallery__thumb:hover {
    transform: translateY(-2px);
  }
  .gallery__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  /* Quiet, collapsible credits — visible attribution without cluttering the grid. */
  .gallery__credits {
    margin-block-start: var(--space-md);
    font-family: var(--font-sans);
  }
  .gallery__credits summary {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brass-600);
    cursor: pointer;
    inline-size: fit-content;
  }
  .gallery__credit-list {
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }
  .gallery__credit-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
  }
  .gallery__credit-cap {
    font-size: 0.8rem;
    color: var(--color-sand-700);
  }

  .lightbox {
    margin: auto;
    border: 0;
    padding: 0;
    background: transparent;
    max-inline-size: min(92vw, 64rem);
    max-block-size: 92vh;
  }
  .lightbox::backdrop {
    background: rgb(28 25 21 / 0.86);
  }
  .lightbox__fig {
    margin: 0;
  }
  .lightbox__img {
    display: block;
    inline-size: 100%;
    max-block-size: 78vh;
    object-fit: contain;
    border-radius: var(--radius-md);
  }
  .lightbox__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem 0.6rem;
    margin-block-start: var(--space-sm);
    font-family: var(--font-sans);
    text-align: center;
  }
  .lightbox__caption {
    font-size: 0.9rem;
    color: var(--color-sand-100);
  }
  .lightbox__credit {
    font-size: 0.75rem;
    color: var(--color-sand-300);
  }
  .lightbox__caption:empty,
  .lightbox__credit:empty {
    display: none;
  }
  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-sm);
  }
  .lightbox__btn {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    border: 1px solid rgb(251 247 238 / 0.3);
    border-radius: 50%;
    background: rgb(251 247 238 / 0.08);
    color: var(--color-sand-50);
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }
  .lightbox__btn:hover {
    background: rgb(251 247 238 / 0.2);
  }
  .lightbox__count {
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
    color: var(--color-sand-100);
    min-inline-size: 4ch;
    text-align: center;
  }
</style>
