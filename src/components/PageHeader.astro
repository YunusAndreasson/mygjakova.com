---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="page-head wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="page-head__title">{title}</h1>
  {lede && <p class="page-head__lede">{lede}</p>}
</header>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem) 2.5rem;
    /* No width cap here: a 60rem cap + the .wrap auto-margins centred the header
       inside the wider (76rem) content grid, so it no longer shared the content's
       left edge. The lede keeps its own readable measure below. */
  }
  .page-head__title {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    margin-block: 0.85rem 0;
  }
  .page-head__lede {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-sand-700);
    max-inline-size: 54ch;
    margin-block-start: 1rem;
  }
</style>
