---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="page-head wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="page-head__title">{title}</h1>
  {lede && <p class="page-head__lede">{lede}</p>}
</header>

<style>
  .page-head {
    /* No cap on the header block (it is also a .wrap — a cap + auto margins
       would centre it and break the shared left edge). The title carries its
       own measure instead; the lede keeps a readable measure below. */
    padding-block: var(--space-section) var(--space-xl);
  }
  .page-head__title {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    margin-block: var(--space-sm) 0;
    /* Editorial measure (block cap, not auto-centred) so a long title wraps
       early but stays on the content's left edge. */
    max-inline-size: var(--measure-tight);
  }
  .page-head__lede {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-sand-700);
    max-inline-size: var(--measure-head);
    margin-block-start: var(--space-md);
  }
</style>
