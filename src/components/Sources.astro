---
import { useTranslations, type Locale } from '~/i18n/utils';

interface Source {
  label: string;
  url?: string;
}

interface Props {
  sources: Source[];
  lang: Locale;
  /** 'block' = headed list (guide pages); 'inline' = compact row (timeline). */
  variant?: 'block' | 'inline';
}

const { sources, lang, variant = 'block' } = Astro.props;
const t = useTranslations(lang);
---

{
  sources.length > 0 && (
    <div class:list={['sources', `sources--${variant}`]}>
      {variant === 'block' && <h2 class="sources__title">{t('sources.title')}</h2>}
      <ul class="sources__list">
        {sources.map((s) => (
          <li class="sources__item">
            {s.url ? (
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            ) : (
              <span>{s.label}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .sources--inline {
    margin-block-start: var(--space-md);
  }
  .sources--block {
    margin-block-start: var(--space-lg);
  }
  .sources__title {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brass-600);
    margin: 0 0 var(--space-sm);
  }
  .sources__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-sand-600);
  }
  .sources--block .sources__list {
    display: grid;
    gap: var(--space-2xs);
  }
  .sources--inline .sources__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    font-size: 0.8rem;
  }
  .sources__item a {
    color: var(--color-terracotta-600);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .sources__item a:hover {
    color: var(--color-terracotta-700);
  }
</style>
