---
// A small, self-hosted locator map: the silhouette of Kosovo with Gjakova
// pinned in the west and the capital, Prishtina, shown as a faint reference.
// Geometry is pre-projected at build time (scripts/gen-locator.mjs) into
// src/lib/kosovoLocator.ts, so this is a pure inline SVG — no JS, no tiles, no
// third-party request, nothing for the CSP to allow. Decorative-but-useful
// orientation for readers who don't know where Gjakova is.
import { kosovoLocator } from '~/lib/kosovoLocator';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const { viewBox, outline, markers } = kosovoLocator;
const subject = markers.find((m) => m.role === 'subject');
const reference = markers.find((m) => m.role === 'reference');
const labelFor = (key: string) => (key === 'gjakova' ? t('site.name') : t('locator.capital'));
---

<figure class="locator">
  <svg
    class="locator__svg"
    viewBox={viewBox}
    role="img"
    aria-label={t('locator.alt')}
    xmlns="http://www.w3.org/2000/svg"
  >
    <path class="locator__land" d={outline} vector-effect="non-scaling-stroke" />

    {
      reference && (
        <g class="locator__ref">
          <circle cx={reference.x} cy={reference.y} r="1.3" />
          <text x={reference.x} y={reference.y - 3} text-anchor="middle">
            {labelFor(reference.key)}
          </text>
        </g>
      )
    }

    {
      subject && (
        <g class="locator__subject">
          <circle class="locator__halo" cx={subject.x} cy={subject.y} r="5" />
          <circle class="locator__dot" cx={subject.x} cy={subject.y} r="2.4" />
          <text x={subject.x} y={subject.y + 8.5} text-anchor="middle">
            {labelFor(subject.key)}
          </text>
        </g>
      )
    }
  </svg>
  <figcaption class="locator__caption">{t('locator.title')}</figcaption>
</figure>

<style>
  .locator {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .locator__svg {
    inline-size: 100%;
    block-size: auto;
    overflow: visible; /* let edge labels breathe past the country bounds */
  }
  .locator__land {
    fill: var(--color-sand-200);
    stroke: var(--color-sand-400);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }
  /* Gjakova — the subject. Soft halo + solid terracotta dot. */
  .locator__halo {
    fill: var(--color-terracotta-500);
    opacity: 0.16;
  }
  .locator__dot {
    fill: var(--color-terracotta-500);
    stroke: var(--color-surface);
    stroke-width: 0.9;
  }
  .locator__subject text {
    font-family: var(--font-sans);
    font-size: 6.2px;
    font-weight: 600;
    fill: var(--color-ink);
  }
  /* Prishtina — a quiet orientation reference. */
  .locator__ref circle {
    fill: var(--color-sand-600);
  }
  .locator__ref text {
    font-family: var(--font-sans);
    font-size: 4.6px;
    fill: var(--color-sand-600);
  }
  .locator__caption {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--color-sand-600);
    text-align: center;
  }
</style>
