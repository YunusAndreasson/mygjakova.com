---
import LanguageSwitcher from '~/components/LanguageSwitcher.astro';
import Ornament from '~/components/Ornament.astro';
import { useTranslations, localizedPath, type Locale } from '~/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const items = [
  { key: 'nav.places', path: '/places' },
  { key: 'nav.timeline', path: '/timeline' },
  { key: 'nav.about', path: '/about' },
] as const;
---

<footer class="site-footer">
  <div class="wrap site-footer__seal">
    <Ornament variant="seal" tone="brass" />
  </div>
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name">{t('site.name')}</p>
      <p class="site-footer__tagline">{t('footer.tagline')}</p>
    </div>

    <nav class="site-footer__nav" aria-label={t('a11y.footerNav')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={localizedPath(lang, item.path)}>{t(item.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__lang">
      <LanguageSwitcher lang={lang} />
    </div>
  </div>

  <div class="wrap site-footer__base">
    <p>© {year} {t('site.name')}. {t('footer.rights')}</p>
    <p class="site-footer__credit">
      {t('footer.credit')} ·{' '}
      <a href="https://andreassonphoto.com" rel="author noopener">andreassonphoto.com</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    margin-block-start: var(--space-4xl);
    background: var(--color-sand-900);
    color: var(--color-sand-200);
    font-family: var(--font-sans);
  }
  /* Same paper grain as the page body — its opaque dark fill hides the global
     one, so it gets its own faint overlay for a consistent tactile surface. */
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 160px 160px;
    opacity: 0.06;
    mix-blend-mode: overlay;
  }
  /* Eight-point-star lattice — a second, fainter layer over the dark fill
     (overlay lifts the baked ink to a faint light line). Behind content. */
  .site-footer::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: var(--motif-star);
    background-size: 64px 64px;
    opacity: 0.07;
    mix-blend-mode: overlay;
  }
  /* The seal sits centred above the footer columns. */
  .site-footer__seal {
    padding-block-start: var(--space-3xl);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-footer);
    justify-content: space-between;
    /* Top breathing room is carried by the seal above. */
    padding-block: var(--space-lg) var(--space-xl);
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-sand-50);
    margin: 0;
  }
  .site-footer__tagline {
    margin: var(--space-2xs) 0 0;
    color: var(--color-sand-400);
    max-inline-size: var(--measure-tight);
  }
  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }
  .site-footer__nav a {
    color: var(--color-sand-200);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .site-footer__nav a:hover {
    color: var(--color-brass-300);
  }
  .site-footer__base {
    padding-block: var(--space-lg) var(--space-xl);
    border-block-start: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.85rem;
    color: var(--color-sand-500);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-lg);
    justify-content: space-between;
  }
  .site-footer__base p {
    margin: 0;
  }
  .site-footer__credit a {
    color: var(--color-sand-400);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: color 0.15s ease;
  }
  .site-footer__credit a:hover {
    color: var(--color-brass-300);
  }
  /* Brighten the switcher on the dark footer */
  .site-footer__lang :global(.lang__link) {
    color: var(--color-sand-300);
  }
  .site-footer__lang :global(.lang__link[aria-current='true']) {
    color: var(--color-sand-50);
  }
</style>
