---
import type { CollectionEntry } from 'astro:content';
import OptimizedImage from '~/components/OptimizedImage.astro';
import PlaceholderPlate from '~/components/PlaceholderPlate.astro';
import { entrySlug } from '~/lib/collections';
import { localizedPath, useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  place: CollectionEntry<'places'>;
  lang: Locale;
  priority?: boolean;
}

const { place, lang, priority = false } = Astro.props;
const t = useTranslations(lang);
const { title, summary, category, era, hero, heroAlt } = place.data;
const href = localizedPath(lang, `/places/${entrySlug(place.id)}`);
---

<a class="card" href={href}>
  <div class="card__media">
    {
      hero ? (
        <OptimizedImage
          src={hero}
          alt={heroAlt ?? title}
          ratio="4 / 3"
          sizes="(min-width: 900px) 30rem, 100vw"
          widths={[400, 600, 900]}
          priority={priority}
          transition:name={`place-${entrySlug(place.id)}`}
        />
      ) : (
        <PlaceholderPlate
          title={title}
          category={category}
          aspect="4 / 3"
          label={false}
          transitionName={`place-${entrySlug(place.id)}`}
        />
      )
    }
    {/* Category chip in both cases — single, consistent identifier; the place
        name lives only in the card body, never duplicated over the media. */}
    <span class="card__cat">{category}</span>
  </div>
  <div class="card__body">
    <h3 class="card__title">{title}</h3>
    {era && <p class="card__era">{era}</p>}
    <p class="card__summary">{summary}</p>
    <span class="card__cta">{t('places.viewGuide')}<span aria-hidden="true"> →</span></span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }
  .card__media {
    position: relative;
  }
  .card__media :global(.oimg) {
    aspect-ratio: 4 / 3;
  }
  .card__media :global(img) {
    transition: transform 0.5s ease;
  }
  .card:hover .card__media :global(img) {
    transform: scale(1.04);
  }
  /* Gentle parallax on the plate's arch motif when the card lifts. */
  .card__media :global(.plate__arch) {
    transition: transform var(--dur-slow) var(--ease), opacity var(--dur-slow) var(--ease);
  }
  .card:hover .card__media :global(.plate__arch) {
    transform: translateY(-3%) scale(1.03);
    opacity: 0.2;
  }
  .card__cat {
    position: absolute;
    inset-block-start: var(--space-sm);
    inset-inline-start: var(--space-sm);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-sand-50);
    background: rgb(28 25 21 / 0.55);
    backdrop-filter: blur(4px);
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-xs);
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--gap-body);
    padding: var(--space-lg);
    /* Fill the card's height (cards in a row stretch to equal height) so the CTA
       below can pin to the bottom edge. */
    flex: 1;
  }
  .card__title {
    font-size: 1.5rem;
    line-height: 1.15;
    /* Reserve two lines so the era, summary and CTA rows align across the cards
       in a row whether the place name runs to one line or two. */
    min-block-size: 2.3em;
  }
  .card__era {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brass-600);
    margin: 0;
  }
  .card__summary {
    font-family: var(--font-serif);
    color: var(--color-sand-700);
    line-height: 1.55;
    margin: 0;
  }
  .card__cta {
    /* Pin to the bottom of the body so the "Read the guide" links line up across
       a row regardless of summary length. */
    margin-block-start: auto;
    padding-block-start: var(--space-xs);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-terracotta-600);
  }
  /* Touch devices: the hover lift would "stick" after a tap, so swap it for an
     instant press that feels like a native list cell being pressed. */
  @media (hover: none) {
    .card:hover {
      transform: none;
      box-shadow: var(--shadow-soft);
    }
    .card:hover .card__media :global(img) {
      transform: none;
    }
    .card:active {
      transform: scale(0.985);
    }
  }
</style>
