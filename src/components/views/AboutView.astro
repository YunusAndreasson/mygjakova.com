    colophonLeadBefore: `Guiden sätts samman av ${authorName} — fotograf (`,
    colophonLeadAfter:
      '), inte historiker och ingen lokal myndighet. Den har vuxit fram ur återkommande besök under det senaste decenniet: långa promenader genom det gamla kvarteret, värmen hos människorna som bor där, och det de var generösa nog att lära en nyfiken besökare om sin stads förflutna.',
    colophonRest: [
      'Läs den alltså som en resenärs anteckningar snarare än som en slutgiltig skildring. Där den kan lutar den sig mot publicerade källor och lokal forskning — men alla fel är mina, och rättelser tas tacksamt emot.',
      'Sajten är ett pågående arbete. Platser, fotografier och berättelser fortsätter att tillkomma.',
    ],
    closingPhotoAlt:
      'En stentrappa som klättrar genom tät grönska i den gamla staden, upplyst av ett ljusstråk.',
    closingPhotoCaption: 'Trappsteg i den gamla staden.',
  },
};

const c = copy[lang];
// The portfolio link text shows the bare domain, regardless of locale.
const authorLinkText = authorUrl.replace(/^https?:\/\//, '');
---

<PageHeader eyebrow={c.eyebrow} title={t('about.title')} lede={c.lede} />

<section class="wrap about">
  <div class="prose prose--lead about__intro">
    {c.intro.map((p) => <p>{p}</p>)}
  </div>

  <section class="hook" aria-labelledby="hook-title">
    <div class="hook__text">
      <p class="eyebrow">{c.hook.eyebrow}</p>
      <h2 class="hook__title" id="hook-title">{c.hook.title}</h2>
      <figure class="hook__quote">
        <blockquote>{c.hook.quote}</blockquote>
        <figcaption>{c.hook.attribution}</figcaption>
      </figure>
      <p class="hook__body">
        {c.hook.leadIn}<a href={localizedPath(lang, '/places/grand-bazaar')}>{c.hook.bazaarLabel}</a
        >{c.hook.midText}<a href={localizedPath(lang, '/places/hadum-library')}
          >{c.hook.libraryLabel}</a
        >{c.hook.tailText}
      </p>
    </div>
    <div class="hook__media">
      <Figure
        src={manuscript}
        alt={c.quoteImageAlt}
        caption={c.quoteImageCaption}
        credit={manuscriptCredit}
        widths={[280, 420, 640]}
        sizes="(min-width: 60rem) 18rem, min(60vw, 16rem)"
      />
    </div>
  </section>

  <div class="brief">
    <div class="brief__map">
      <KosovoLocator lang={lang} />
    </div>
    <FactsPanel title={c.factsTitle} facts={c.facts} note={c.factsNote} />
  </div>

  <div class="about__rule">
    <Ornament variant="divider" tone="line" />
  </div>

  <div class="colophon">
    <div class="prose about__colophon">
      <h2 class="about__colophon-title">{c.colophonTitle}</h2>
      <p>
        {c.colophonLeadBefore}<a href={authorUrl} rel="author noopener">{authorLinkText}</a>{
          c.colophonLeadAfter
        }
      </p>
      {c.colophonRest.map((p) => <p>{p}</p>)}
    </div>

    <div class="about__photo">
      <Figure
        src={cityCenter}
        alt={c.closingPhotoAlt}
        caption={c.closingPhotoCaption}
        credit={ownCredit}
        widths={[360, 540, 720]}
        sizes="(min-width: 60rem) 20rem, 100vw"
      />
    </div>
  </div>
</section>

<style>
  .about {
    padding-block-end: var(--space-xl);
  }
  /* Rhythm between the blocks (intro → hook → facts → colophon). */
  .about > * + * {
    margin-block-start: var(--space-section);
  }

  /* The hook — a 1662 pull-quote as the page's centrepiece, on the paper
     ground so it reads distinctly from the tinted facts panel below it. On wide
     screens the Seyahatnâme title page sits beside the text it is quoted from. */
  @media (min-width: 60rem) {
    .hook {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(13rem, 18rem);
      gap: var(--gap-layout);
      align-items: start;
    }
  }
  .hook__media {
    margin-block-start: var(--space-lg);
    max-inline-size: 16rem;
    margin-inline: auto;
  }
  @media (min-width: 60rem) {
    .hook__media {
      /* Sit the plate near the top of the text column so the right side fills
         from the title down, rather than floating low with an empty top. */
      margin-block-start: var(--space-md);
      margin-inline: 0;
      max-inline-size: none;
    }
  }
  .hook__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--color-ink);
    margin-block: var(--space-sm) 0;
    max-inline-size: var(--measure-head);
    text-wrap: balance;
  }
  .hook__quote {
    margin: var(--space-lg) 0 0;
    padding-inline-start: var(--space-lg);
    border-inline-start: 3px solid var(--color-brass-400);
    max-inline-size: var(--measure);
  }
  .hook__quote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.2rem, 0.95rem + 1.3vw, 1.6rem);
    line-height: 1.42;
    color: var(--color-sand-800);
  }
  .hook__quote figcaption {
    margin-block-start: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-terracotta-600);
  }
  .hook__body {
    margin-block-start: var(--space-lg);
    max-inline-size: var(--measure);
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-sand-800);
  }
  .hook__body a {
    color: var(--color-terracotta-600);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  /* Gjakova in brief — a Kosovo locator map paired with the facts plate. Both
     sit in matching cards of equal height so the two columns balance, rather
     than a small map floating on the bare ground beside a tinted panel. */
  .brief {
    display: grid;
    gap: var(--gap-layout);
    align-items: stretch;
  }
  @media (min-width: 50rem) {
    .brief {
      grid-template-columns: minmax(13rem, 0.9fr) 1.1fr;
    }
  }
  .brief__map {
    display: grid;
    place-items: center;
    background: var(--color-sand-200);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: var(--space-pad-card);
  }
  .brief__map :global(.locator) {
    inline-size: 100%;
    max-inline-size: 20rem;
  }
  /* The locator's land fill is sand-200 — the same as this card — so lighten it
     to read against the matching tint. */
  .brief__map :global(.locator__land) {
    fill: var(--color-surface);
  }

  /* Colophon — the signed note set beside a closing photograph: text left, the
     author's own photo right on wide screens, so the page ends balanced rather
     than with a lone left-aligned image and an empty right. Set apart from the
     body by the star rule above. */
  .colophon {
    display: grid;
    gap: var(--gap-layout);
  }
  @media (min-width: 60rem) {
    .colophon {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
      align-items: start;
    }
  }
  .about__colophon-title {
    font-size: 1.5rem;
    margin-block: 0 var(--space-sm);
  }
  .about__photo {
    max-inline-size: 34rem;
    margin-inline: 0;
  }
  @media (min-width: 60rem) {
    .about__photo {
      /* Drop the photo to sit beside the body, aligned with the colophon prose
         rather than its heading. */
      margin-block-start: var(--space-2xl);
      max-inline-size: none;
    }
  }
</style>
