---
import OptimizedImage from '~/components/OptimizedImage.astro';
import PlaceholderPlate from '~/components/PlaceholderPlate.astro';
import PlaceCard from '~/components/PlaceCard.astro';
import Ornament from '~/components/Ornament.astro';
import { getPlaces, getTimeline } from '~/lib/collections';
import { useTranslations, localizedPath, type Locale } from '~/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const places = await getPlaces(lang);
const featured = [...places]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);
const lead = featured[0];
const timeline = await getTimeline(lang);
// The home page only *teases* the timeline: show the opening of the story and
// send readers to /timeline for the full arc, rather than listing every event.
const timelineTeaser = timeline.slice(0, 6);
---

<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="eyebrow">{t('home.hero.eyebrow')}</p>
      <h1 class="hero__title">{t('home.hero.title')}</h1>
      <p class="hero__lede">{t('home.hero.lede')}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={localizedPath(lang, '/places')}>
          {t('home.hero.cta.places')}
        </a>
        <a class="btn btn--ghost" href={localizedPath(lang, '/timeline')}>
          {t('home.hero.cta.timeline')}
        </a>
      </div>
    </div>
    <div class="hero__media">
      {
        lead?.data.hero ? (
          <OptimizedImage
            src={lead.data.hero}
            alt={lead.data.heroAlt ?? lead.data.title}
            priority
            sizes="(min-width: 900px) 34rem, 100vw"
            widths={[640, 960, 1280, 1672]}
            class="hero__img"
          />
        ) : (
          <PlaceholderPlate
            title={lead?.data.title ?? t('site.name')}
            kind={lead?.data.category}
            category={lead?.data.category}
            aspect="4 / 5"
            framed
          />
        )
      }
    </div>
  </div>
</section>

<section class="section wrap" data-reveal>
  <header class="section__head">
    <p class="eyebrow">{t('home.places.eyebrow')}</p>
    <h2 class="section__title">{t('home.places.title')}</h2>
    <p class="section__lede">{t('home.places.lede')}</p>
  </header>
  <div class="card-grid">
    {featured.map((place, i) => <PlaceCard place={place} lang={lang} priority={i === 0} />)}
  </div>
</section>

{
  timeline.length > 0 && (
    <>
      <div class="wrap home-rule">
        <Ornament variant="divider" tone="brass" />
      </div>
      <section class="teaser" data-reveal>
        <div class="wrap">
          <h2 class="teaser__title">{t('timeline.title')}</h2>
          <ol class="teaser__list">
            {timelineTeaser.map((e) => (
              <li class="teaser__item">
                <span class="teaser__date">{e.data.displayDate ?? e.data.year}</span>
                <span class="teaser__label">{e.data.title}</span>
              </li>
            ))}
          </ol>
          <a class="teaser__cta" href={localizedPath(lang, '/timeline')}>
            {t('home.hero.cta.timeline')}<span aria-hidden="true"> →</span>
          </a>
        </div>
      </section>
    </>
  )
}

<style>
  /* Hero */
  .hero {
    padding-block: var(--space-section-lg);
  }
  .hero__grid {
    display: grid;
    gap: var(--gap-grid-lg);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
  .hero__title {
    font-size: var(--text-hero);
    line-height: var(--text-hero--line-height);
    letter-spacing: var(--text-hero--letter-spacing);
    margin-block: var(--space-md) var(--space-lg);
    /* Let the grid column govern the measure — a tight ch-cap here left a big
       empty gap to the right of the wrapped title. */
    text-wrap: balance;
  }
  .hero__lede {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-sand-700);
    max-inline-size: var(--measure-head);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
  }
  .hero__media {
    position: relative;
  }
  /* Real illustration in the hero — match the framed plate's rounded, lifted look.
     The 16:9 source is cover-cropped to the portrait frame (centred on the arcade). */
  .hero__media :global(.hero__img) {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
  }

  /* Section heading */
  .section {
    padding-block: var(--space-section);
  }
  .section__head {
    max-inline-size: var(--measure-head);
    margin-block-end: var(--space-2xl);
  }
  .section__title {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    margin-block: var(--space-sm);
  }
  .section__lede {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-sand-700);
  }
  /* Star separator between the cards and the timeline band: give it symmetric
     air so it floats on the paper instead of hugging the band's top edge. */
  .home-rule {
    margin-block-end: var(--space-section);
  }
  /* Timeline teaser */
  .teaser {
    position: relative;
    isolation: isolate;
    background: var(--color-sand-200);
    /* Lighter top pad — the star rule above already leads into the band. */
    padding-block: var(--space-lg) var(--space-section);
    /* Top edge is carried by the star divider above; keep only the lower rule. */
    border-block-end: 1px solid var(--color-line);
  }
  /* Faint eight-point-star lattice over the sand band — the ornamental cousin of
     the paper grain. Sits behind content; never animated. */
  .teaser::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: var(--motif-star);
    background-size: 64px 64px;
    opacity: 0.05;
    mix-blend-mode: multiply;
  }
  .teaser__title {
    font-size: var(--text-display);
    margin-block-end: var(--space-lg);
  }
  .teaser__list {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
    display: grid;
    gap: 0;
  }
  .teaser__item {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-lg);
    align-items: baseline;
    padding-block: var(--space-md);
    border-block-start: 1px solid var(--color-line);
  }
  .teaser__item:last-child {
    border-block-end: 1px solid var(--color-line);
  }
  .teaser__date {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--color-terracotta-600);
    font-variant-numeric: tabular-nums;
  }
  .teaser__label {
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .teaser__cta {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-terracotta-600);
    text-decoration: none;
  }
</style>
