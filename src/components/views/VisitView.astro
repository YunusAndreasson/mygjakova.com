interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface Fact {
  term: string;
  value: string;
}
interface Route {
  origin: string;
  badge?: string;
  meta: string;
  note: string;
}
interface Season {
  name: string;
  pick: boolean;
  note: string;
}
interface Stay {
  name: string;
  type: string;
  best: string;
  note: string;
}
/** The one paragraph with links is split around them, the AboutView way. */
interface Halal {
  intro: string;
  foodHead: string;
  food: string[];
  prayerHead: string;
  prayerBefore: string;
  mosqueLabel: string;
  prayerMid: string;
  bazaarLabel: string;
  prayerAfter: string;
  prayerMore: string[];
  moneyHead: string;
  money: string[];
}
interface VisitSource {
  label: string;
  url?: string;
}
interface VisitCopy {
  eyebrow: string;
  lede: string;
  essentialsTitle: string;
  essentials: Fact[];
  essentialsNote: string;
  gettingTitle: string;
  gettingIntro: string;
  routes: Route[];
  arrivalNote: string;
  whenTitle: string;
  whenIntro: string;
  climateLead: string;
  seasonPickLabel: string;
  seasons: Season[];
  stayTitle: string;
  stayIntro: string;
  stays: Stay[];
  stayNote: string;
  halalTitle: string;
  halal: Halal;
  mosquesTitle: string;
  mosquesIntro: string;
  mosquesNote: string;
  figures: {
    qyl: { alt: string; caption: string };
    gate: { alt: string; caption: string };
    mosque: { alt: string; caption: string };
    window: { alt: string; caption: string };
    courtyard: { alt: string; caption: string };
    portico: { alt: string; caption: string };
  };
  sources: VisitSource[];
}

