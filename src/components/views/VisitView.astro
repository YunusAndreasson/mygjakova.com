const copy: Partial<Record<Locale, VisitCopy>> = { en: enCopy, sq: sqCopy, de: deCopy, tr: trCopy };
const c = copy[lang] ?? enCopy;

// The Hadum anchors the mosque map (terracotta centre marker); the rest render
// as brass markers with a name popup on tap.
const primaryMosque = mosques.find((m) => m.primary) ?? mosques[0];
const mosqueMarkers = mosques
  .filter((m) => m !== primaryMosque)
  .map((m) => ({ lat: m.lat, lng: m.lng, label: m.name }));

// The site's own photography credit (matches the timeline / place-gallery byline).
const ownCredit = {
  author: 'Yunus Andreasson',
  source: '@andreasson.photo',
  url: 'https://www.instagram.com/andreasson.photo/',
};
---

<PageHeader eyebrow={c.eyebrow} title={t('visit.title')} lede={c.lede} />

<div class="wrap visit">
  <div class="visit__essentials" data-reveal>
    <FactsPanel title={c.essentialsTitle} facts={c.essentials} note={c.essentialsNote} />
  </div>

  <section class="visit__section" data-reveal aria-labelledby="visit-getting">
    <h2 class="visit__h" id="visit-getting">{c.gettingTitle}</h2>
    <div class="getting">
      <p class="visit__lead">{c.gettingIntro}</p>
      <div class="visit__locator"><KosovoLocator lang={lang} /></div>
    </div>
    <div class="routes card-grid">
      {
        c.routes.map((r) => (
          <article class="route">
            <div class="route__top">
