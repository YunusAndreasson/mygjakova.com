---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import OptimizedImage from '~/components/OptimizedImage.astro';
import PlaceholderPlate from '~/components/PlaceholderPlate.astro';
import PlaceMap from '~/components/PlaceMap.astro';
import Sources from '~/components/Sources.astro';
import PlaceCard from '~/components/PlaceCard.astro';
import Gallery from '~/components/Gallery.astro';
import TableOfContents from '~/components/TableOfContents.astro';
import PlaceActions from '~/components/PlaceActions.astro';
import { getPlaces, entrySlug } from '~/lib/collections';
import { useTranslations, localizedPath, type Locale } from '~/i18n/utils';

interface Props {
  place: CollectionEntry<'places'>;
  lang: Locale;
}

const { place, lang } = Astro.props;
const t = useTranslations(lang);
const { Content, headings } = await render(place);

const {
  title,
  summary,
  hero,
  heroAlt,
  category,
  era,
  coordinates,
  address,
  gallery,
  related,
  sources,
} = place.data;
const slug = entrySlug(place.id);

const all = await getPlaces(lang);
const relatedPlaces = all.filter(
  (p) => related.includes(entrySlug(p.id)) && entrySlug(p.id) !== slug,
);

// Coordinates of related places become muted secondary markers on the map.
const relatedMarkers = relatedPlaces
  .filter((p) => p.data.coordinates)
  .map((p) => ({
    lat: p.data.coordinates!.lat,
    lng: p.data.coordinates!.lng,
    label: p.data.title,
    href: localizedPath(lang, `/places/${entrySlug(p.id)}`),
  }));
---

<article class="guide">
  <div class="wrap">
    <a class="guide__back" href={localizedPath(lang, '/places')}>
      <span aria-hidden="true">←</span> {t('places.backToPlaces')}
    </a>
  </div>

  <div class="wrap">
    {
      hero ? (
        <OptimizedImage
          src={hero}
          alt={heroAlt ?? title}
          priority
          ratio="16 / 9"
          sizes="(min-width: 1200px) 72rem, 100vw"
          widths={[768, 1200, 1600, 1920]}
          class="guide__hero"
          transition:name={`place-${slug}`}
        />
      ) : (
        <PlaceholderPlate
          title={title}
          category={category}
          aspect="16 / 9"
          framed
          label={false}
          transitionName={`place-${slug}`}
        />
      )
    }
  </div>

  <header class="wrap guide__head">
    <p class="guide__meta">
      <span class="guide__cat">{category}</span>
      {era && <span class="guide__era">{era}</span>}
    </p>
    <h1 class="guide__title">{title}</h1>
    <p class="guide__summary">{summary}</p>
  </header>

  <div class="wrap guide__layout">
    <div class="prose prose--lead guide__content">
      <Content />
    </div>

    <aside class="guide__aside">
      {
        coordinates && (
          <PlaceMap
            lat={coordinates.lat}
            lng={coordinates.lng}
            label={address ?? title}
            markers={relatedMarkers}
            lang={lang}
          />
        )
      }
      {!coordinates && address && <p class="guide__address">{address}</p>}
      <PlaceActions title={title} lat={coordinates?.lat} lng={coordinates?.lng} lang={lang} />
      <TableOfContents headings={headings} lang={lang} />
      <Sources sources={sources} lang={lang} />
    </aside>
  </div>

  {
    gallery.length > 0 && (
      <div class="wrap">
        <Gallery images={gallery} lang={lang} />
      </div>
    )
  }

  {
    relatedPlaces.length > 0 && (
      <section class="wrap guide__related">
        <h2 class="guide__related-title">{t('places.related')}</h2>
        <div class="card-grid">
          {relatedPlaces.map((p) => (
            <PlaceCard place={p} lang={lang} />
          ))}
        </div>
      </section>
    )
  }
</article>

<style>
  .guide__back {
    display: inline-block;
    margin-block: var(--space-lg);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-sand-700);
    text-decoration: none;
  }
  .guide__back:hover {
    color: var(--color-terracotta-600);
  }
  .guide__hero {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    aspect-ratio: 16 / 9;
  }
  .guide__head {
    /* No inline-size cap on the header block itself: it is also a .wrap, whose
       auto margins would centre a capped block and break the shared left edge.
       The title and summary carry their own measures below instead. */
    padding-block: var(--space-section) var(--space-lg);
  }
  .guide__meta {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    margin: 0 0 var(--space-sm);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .guide__cat {
    color: var(--color-sand-50);
    background: var(--color-terracotta-500);
    padding: var(--space-3xs) var(--space-sm);
    border-radius: var(--radius-xs);
  }
  .guide__era {
    color: var(--color-brass-600);
  }
  .guide__title {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    margin: 0;
    /* Keep an editorial measure on very wide screens without auto-centring —
       a block cap wraps long names early but stays on the left edge. */
    max-inline-size: var(--measure-tight);
  }
  .guide__summary {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.55;
    color: var(--color-sand-700);
    margin-block-start: var(--space-md);
    max-inline-size: var(--measure-head);
  }
  .guide__layout {
    display: grid;
    gap: var(--gap-layout);
    align-items: start;
  }
  .guide__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  @media (min-width: 900px) {
    .guide__layout {
      grid-template-columns: 1fr var(--sidebar);
    }
    .guide__aside {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-md));
    }
  }
  .guide__address {
    font-family: var(--font-sans);
    color: var(--color-sand-700);
  }
  .guide__related {
    margin-block-start: var(--space-section);
  }
  .guide__related-title {
    /* A subordinate section heading — deliberately set below the page H1
       (--text-display) so the visual hierarchy reads title → section. */
    font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem);
    margin-block-end: var(--space-lg);
  }
</style>
