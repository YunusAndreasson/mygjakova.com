---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import {
  resolveLocale,
  getDirection,
  useTranslations,
  localizedPath,
  stripLocale,
  locales,
} from '~/i18n/utils';
import { ogLocales, type UIKey } from '~/i18n/ui';
import { buildBreadcrumbJsonLd, buildOrganization, buildPerson } from '~/lib/jsonLd';
import { makerName } from '~/lib/maker';
import '~/styles/global.css';

interface Props {
  title?: string;
  /**
   * Full <title> override, used verbatim (no " — siteName" suffix) — for titles
   * worded around search intent. `title` still names the breadcrumb leaf.
   */
  metaTitle?: string;
  description?: string;
  /** Path to an OG image under /public, or absolute URL. */
  image?: string;
  noindex?: boolean;
  /** Extra schema.org node(s) merged into the page's JSON-LD @graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  metaTitle,
  description,
  image = '/og-default.jpg',
  noindex = false,
  jsonLd,
} = Astro.props;

const lang = resolveLocale(Astro.currentLocale);
const dir = getDirection(lang);
const t = useTranslations(lang);

const siteName = t('site.name');
const pageTitle = metaTitle ?? (title ? `${title} — ${siteName}` : `${siteName} — ${t('site.tagline')}`);
const desc = description ?? t('site.description');

// Canonical + hreflang are built from the locale-agnostic path so language
// alternates stay correct on every route.
const origin = Astro.site ?? new URL(Astro.url.origin);
const barePath = stripLocale(Astro.url.pathname);
const canonical = new URL(localizedPath(lang, barePath), origin);
const ogImage = new URL(image, origin);

const alternates = locales.map((l) => ({
  hreflang: l,
  href: new URL(localizedPath(l, barePath), origin).href,
}));

// Breadcrumb trail (structured data only — no visible UI). Built from the
// locale-agnostic path: ancestor sections link out, the current page is the
// leaf. Skipped on the home page, where a one-item crumb is pointless.
const SECTION_NAV: Record<string, UIKey> = {
  places: 'nav.places',
  timeline: 'nav.timeline',
  about: 'nav.about',
  visit: 'nav.visit',
};
const sectionLabel = (seg: string): string => {
  const key = SECTION_NAV[seg];
  return key ? t(key) : seg;
};
const segments = barePath.split('/').filter(Boolean);
const breadcrumb =
  segments.length > 0
    ? buildBreadcrumbJsonLd({
        lang,
        origin: origin.href,
        trail: [
          { name: t('nav.home'), path: '/' },
          ...segments.slice(0, -1).map((seg) => ({ name: sectionLabel(seg), path: `/${seg}` })),
        ],
        leaf: title ?? sectionLabel(segments[segments.length - 1]!),
      })
    : null;

// JSON-LD graph: a site-wide WebSite + Organization (publisher) on every page,
// an optional BreadcrumbList, plus any node(s) a page passes (e.g. a
// TouristAttraction on a place guide), all merged into one @graph.
const ldGraph = [
  {
    '@type': 'WebSite',
    '@id': `${origin.href}#website`,
    name: siteName,
    url: origin.href,
    inLanguage: lang,
    description: desc,
    publisher: { '@id': `${origin.href}#org` },
  },
  buildOrganization({ name: siteName, origin: origin.href }),
  buildPerson(lang),
  ...(breadcrumb ? [breadcrumb] : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
const ld = { '@context': 'https://schema.org', '@graph': ldGraph };
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Google Search Console site verification (HTML-tag method). -->
    <meta name="google-site-verification" content="l0hahSJL9ZCwPWvoVK2trJow4CH7irwIuEFGrb5KkBc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f1e7" />
    <meta name="color-scheme" content="light" />
    <!-- Installed / home-screen app feel (iOS + Android): launches fullscreen,
         titled "myGjakova", with a light status bar matching the theme. -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="myGjakova" />

    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={makerName(lang)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical.href} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('en', barePath), origin).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} — ${t('site.tagline')}`}
      href={new URL(localizedPath(lang, '/rss.xml'), origin).href}
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      locales
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@YunusAndreasson" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <!-- Structured data (schema.org) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />

    <!-- Self-hosted fonts (preloaded) -->
    <Font cssVariable="--ff-display" preload />
    <Font cssVariable="--ff-serif" preload />
    <Font cssVariable="--ff-sans" preload />

    <ClientRouter />
  </head>

  <body>
    <a href="#main" class="skip-link">{t('a11y.skip')}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <style>
      .skip-link {
        position: fixed;
        inset-block-start: var(--space-sm);
        inset-inline-start: var(--space-sm);
        z-index: 100;
        padding: var(--space-sm) var(--space-md);
        border-radius: var(--radius-sm);
        background: var(--color-ink);
        color: var(--color-sand-50);
        font-family: var(--font-sans);
        font-weight: 600;
        transform: translateY(-150%);
        transition: transform 0.18s ease;
      }
      .skip-link:focus-visible {
        transform: translateY(0);
      }
      #main {
        display: block;
        min-height: 60svh;
      }
    </style>
  </body>
</html>
